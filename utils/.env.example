# ─── Timezone ──────────────────────────────────────────
TZ=America/New_York

# ─── Wallos ────────────────────────────────────────────
WALLOS_DB_DIR=./wallos/db
WALLOS_LOGOS_DIR=./wallos/logos

# ─── ntfy ──────────────────────────────────────────────
NTFY_BASE_URL=ntfy_base_url
NTFY_BEHIND_PROXY="true"
NTFY_CONFIG_DIR=./ntfy
NTFY_CACHE_DIR=./ntfy/cache
NTFY_CACHE_FILE="/var/cache/ntfy/cache.db"

# --- speedtest tracker ---------------------------------
APP_KEY=app_key
